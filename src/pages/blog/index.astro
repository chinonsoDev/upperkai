---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { site, absolute } from '../../site';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.title.localeCompare(b.data.title),
);

const blog = {
  '@type': 'Blog',
  name: 'Notes from Upperkai',
  url: absolute('/blog'),
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: absolute(`/blog/${p.id}`),
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---

<Base
  title="Blog | Notes from Upperkai"
  description="Notes from Upperkai on choosing problems, building simple software and learning from the people who use it."
  schema={[blog]}
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Blog</span>
      <h1>Notes from Upperkai</h1>
      <p class="lead">How we choose problems, build simple software and learn from the people who use it.</p>
    </div>
  </section>

  <section class="container" aria-label="All posts">
    <div class="card-grid cols-3">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </section>
</Base>

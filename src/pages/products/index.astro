---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { absolute } from '../../site';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const available = products.filter((p) => p.data.status === 'available');
const comingSoon = products.filter((p) => p.data.status === 'coming-soon');

const itemList = {
  '@type': 'ItemList',
  name: 'Upperkai products',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: absolute(`/products/${p.id}`),
    name: p.data.name,
  })),
};
---

<Base
  title="Products | Upperkai"
  description={`Explore the apps Upperkai builds to make everyday tasks simpler and faster. See what we have shipped${comingSoon.length > 0 ? ' and what is coming next' : ''}.`}
  schema={[itemList]}
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Products</span>
      <h1>Apps that make everyday tasks simpler</h1>
      <p class="lead">Each Upperkai product takes on one everyday job and does it well. Here is what we have shipped{comingSoon.length > 0 && ', and what is coming next'}.</p>
    </div>
  </section>

  {available.length > 0 && (
    <section class="section pt-0" aria-labelledby="available-title">
      <div class="container">
        <h2 id="available-title">Available now</h2>
        <div class="card-grid cols-3 mt-32">
          {available.map((p) => <ProductCard product={p} wide={available.length === 1} />)}
        </div>
      </div>
    </section>
  )}

  {comingSoon.length > 0 && (
    <section class="section section-tint" aria-labelledby="soon-title">
      <div class="container">
        <h2 id="soon-title">Coming next</h2>
        <p class="lead">Products we are building now. Want to hear when they launch? <a href="/contact">Get in touch</a> or subscribe below.</p>
        <div class="card-grid cols-3 mt-32">
          {comingSoon.map((p) => <ProductCard product={p} wide={comingSoon.length === 1} />)}
        </div>
      </div>
    </section>
  )}

  <section class="container section" aria-labelledby="cta-title">
    <div class="cta-band">
      <h2 id="cta-title">Have a task that should be simpler?</h2>
      <p>We are always looking for the next everyday problem worth solving. Tell us yours.</p>
      <a class="btn btn-primary" href="/contact">Get in touch</a>
    </div>
  </section>
</Base>

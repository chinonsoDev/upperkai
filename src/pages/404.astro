---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Page not found | Upperkai" description="The page you were looking for is not on the Upperkai website." canonical={false}>
  <section class="page-head">
    <div class="container narrow">
      <span class="eyebrow">Error 404</span>
      <h1>We could not find that page</h1>
      <p class="lead">It may have moved, or the link may be mistyped. These are good places to start:</p>
      <div class="btn-row mb-40">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-secondary" href="/contact">Contact Upperkai</a>
      </div>
      <h2 class="h-sm">Popular pages</h2>
      <ul class="prose">
        <li><a href="/products">All Upperkai products</a></li>
        {products.map((p) => <li><a href={`/products/${p.id}`}>{p.data.name}</a></li>)}
        <li><a href="/about">About Upperkai</a></li>
      </ul>
    </div>
  </section>
</Base>

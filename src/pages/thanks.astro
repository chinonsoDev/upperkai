---
import Base from '../layouts/Base.astro';
---

<!-- Shown after a form is sent. Not a public page, so it is kept out of search and the sitemap. -->
<Base title="Thank you | Upperkai" description="Thanks for getting in touch with Upperkai." noindex>
  <section class="page-head">
    <div class="container narrow">
      <h1>Thank you</h1>
      <p class="lead">We have your message. If you asked us something, we will reply within two working days.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Back to the home page</a>
        <a class="btn btn-secondary" href="/products">Explore our products</a>
      </div>
    </div>
  </section>
</Base>

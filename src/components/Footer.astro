---
import { getCollection } from 'astro:content';
import { site } from '../site';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const columns = [
  {
    title: 'Products',
    links: [
      ...products.map((p) => ({ href: `/products/${p.id}`, label: p.data.name })),
      { href: '/products', label: 'All products' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About Upperkai' },
      { href: '/contact', label: 'Contact us' },
      { href: '/contact', label: 'Partner with us' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/blog', label: 'Blog' },
      { href: `mailto:${site.supportEmail}`, label: 'Product support' },
      { href: '/sitemap.xml', label: 'Sitemap' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms of Service' },
    ],
  },
];

const icons: Record<string, string> = {
  LinkedIn: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.95 1.32-1.95 2.69V21h-4z',
  X: 'M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.19L2 3h6.33l4.37 5.77zm-1.08 16.17h1.7L7.4 4.73H5.58z',
  Instagram: 'M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2zm0 4.86a4.94 4.94 0 1 0 0 9.88 4.94 4.94 0 0 0 0-9.88zm0 8.15a3.21 3.21 0 1 1 0-6.42 3.21 3.21 0 0 1 0 6.42zm5.14-9.5a1.15 1.15 0 1 0 0 2.3 1.15 1.15 0 0 0 0-2.3z',
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/brand/upperkai-logo-white.svg" alt="Upperkai" width="147" height="30" loading="lazy" />
        <p>Purposeful software that simplifies everyday tasks and leaves people better off for using it.</p>
      </div>

      <div class="footer-cols">
        {columns.map((col) => (
          <nav aria-labelledby={`footer-${col.title.toLowerCase()}`}>
            <h2 id={`footer-${col.title.toLowerCase()}`}>{col.title}</h2>
            <ul>
              {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>

      <form class="signup" name="newsletter" method="POST" action="/thanks" data-collection="newsletterSignups">
        <h2>Get updates from Upperkai</h2>
        <p>Occasional notes when we ship something new. No spam, and you can unsubscribe at any time.</p>
        <p class="hidden-field"><label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label></p>
        <div class="signup-row">
          <label for="signup-email" class="sr-only">Email address</label>
          <input id="signup-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
          <button class="btn btn-light" type="submit">Subscribe</button>
        </div>
        <p class="form-status" role="alert" hidden>That did not go through. Please try again in a moment.</p>
      </form>
    </div>

    <div class="footer-bottom">
      <p class="m-0">© 2026 Upperkai Ventures. All rights reserved.</p>
      <ul class="social" aria-label="Upperkai on social media">
        {site.social.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target="_blank" aria-label={`Upperkai on ${s.name} (opens in a new tab)`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[s.name]} /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<!-- The footer is on every page, so this also covers the contact form. -->
<script>
  import '../scripts/forms.ts';
</script>
